{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"esModuleInterop": true
	},
	"include": ["index.ts", "rules/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
